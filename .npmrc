# vitest@5 wants @types/node ^22/>=24 as a peer, but this project pins
# @types/node to the ^20 range (Next.js/create-next-app's default). The
# actual code doesn't hit anything version-specific between them — this is
# purely npm's strict ERESOLVE peer check being pickier than the real
# runtime compatibility. legacy-peer-deps keeps npm from hard-failing on it,
# matching what we already do explicitly in CI (`npm ci --legacy-peer-deps`)
# and what Vercel's build needs too, since its `npm install` has no flag to
# pass this through otherwise.
legacy-peer-deps=true
