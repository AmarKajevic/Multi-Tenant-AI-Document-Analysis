generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String   @id @default(cuid())
  clerkOrgId  String   @unique
  name        String
  slug        String   @unique
  // No billing provider wired up yet — this just gates which limits apply
  // (see lib/plans.ts). Ready to be flipped by a Stripe webhook later.
  planTier    String   @default("free")
  createdAt   DateTime @default(now())
  members     OrganizationMember[]
  documents   Document[]
  analysisRuns AnalysisRun[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member") 
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  name        String?
  createdAt   DateTime @default(now())
  memberships OrganizationMember[]
  documents   Document[]
  
  @@map("users")
}

model Document {
  id             String   @id @default(cuid())
  name           String
  content        String?
  fileUrl        String?
  fileSize       Int?     
  fileType       String?  
  aiSummary      String?
  aiKeywords     String[]
  sentiment      String?
  organizationId String
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@map("documents")
}

// One row per completed AI analysis. Exists mainly to enforce the monthly
// analysis quota (see lib/usage.ts) — re-analyzing the same document counts
// again, unlike just checking Document.aiSummary != null — but it doubles as
// a lightweight audit trail of AI usage per organization.
model AnalysisRun {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  analysisType   String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("analysis_runs")
}